# ---------------------------------------------------------------------------
# LLM provider (free tier). The app speaks the OpenAI-compatible chat API.
# Default: Google Gemini free tier. Get a key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional overrides. Leave blank to use the provider preset.
LLM_MODEL=
LLM_BASE_URL=

# Provider-specific keys are also read when LLM_API_KEY is empty.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# auto | on | off. Auto enables the labelled zero-key demo when no key exists.
DEMO_MODE=auto

# ---------------------------------------------------------------------------
# Research. auto resolves to: gemini-grounding -> tavily -> searxng -> ddg.
# Gemini grounding reuses LLM_API_KEY. Tavily and SearXNG are optional.
# ---------------------------------------------------------------------------
RESEARCH_PROVIDER=auto
TAVILY_API_KEY=
SEARXNG_URL=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8787
RATE_LIMIT_PER_MIN=10
