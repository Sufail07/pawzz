# Optional. When set, both forms POST JSON here (for example a Google Apps Script
# web-app URL that appends rows to a Google Sheet). When unset, submissions are
# saved in the browser and the success state is still shown.
VITE_FORMS_ENDPOINT=

# OpenStreetMap live refresh uses public Overpass mirrors and needs no key.
# Refresh the checked-in snapshot with: npm run fetch:osm
